# Coreside Launch Website — Environment Variables Template
# Copy this file to .env.local for local development with `vercel dev`
# Configure these variables in your Vercel Project Settings for production

# Supabase Project Configuration (Server-side ONLY)
# CRITICAL SECURITY RULE: NEVER prefix SUPABASE_SERVICE_ROLE_KEY with VITE_
# Doing so would expose full administrative database access in client browser bundles.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Public site URL for canonical tags and Open Graph metadata
VITE_SITE_URL=https://coreside.app

# Optional: Environment flag
NODE_ENV=production
